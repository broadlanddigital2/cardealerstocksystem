{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cardealerstocksystem",
  // worker.ts wraps the OpenNext worker to add the cron (scheduled) handler.
  "main": "worker.ts",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Jobs that ran on timers inside the old always-on Express server.
  //   */15 * * * *  -> showroom-sweep (remove sold cars from the website on schedule)
  //   */30 * * * *  -> orphan-uploads (delete uploads never attached to a record)
  //   0 6 * * *     -> cazoo-health   (daily Cazoo import canary)
  "triggers": {
    "crons": ["*/15 * * * *", "*/30 * * * *", "0 6 * * *"]
  },
  // Non-secret configuration. Secrets (DATABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
  // SENDGRID_API_KEY, CRON_SECRET, RAPID_CAR_CHECK_API_KEY, FIRECRAWL_API_KEY) are set
  // with `wrangler secret put` or in the Cloudflare dashboard.
  "vars": {
    "DB_SCOPE": "request",
    "SUPABASE_URL": "https://bvtqaehyqchyoaleiggw.supabase.co",
    "STORAGE_BUCKET": "stock-book",
    // Email goes out via the SendGrid API (secret: SENDGRID_API_KEY). The
    // from-address must be a verified sender / authenticated domain in SendGrid.
    "ENQUIRY_EMAIL_FROM": "noreply@motormetric-mg.co.uk",
    "EMAIL_FROM_NAME": "MotorMetric",
    "RAPID_CAR_CHECK_DOMAIN": "motormetric-mg.co.uk"
  }
}
