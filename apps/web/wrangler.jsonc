{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cardealerstocksystem",
  // worker.ts wraps the OpenNext worker to add the cron (scheduled) handler.
  "main": "worker.ts",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Custom domain (the racecargraphics.uk zone must be in this Cloudflare
  // account; deploy creates the DNS record and certificate automatically).
  "routes": [
    { "pattern": "cardealerstockbook.racecargraphics.uk", "custom_domain": true }
  ],
  // Uploaded files (dealer logo, vehicle photos, showroom icons).
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "cardealerstocksystem-files" }
  ],
  "observability": {
    "enabled": true
  },
  // Jobs that ran on timers inside the old always-on Express server.
  //   */15 * * * *  -> showroom-sweep (remove sold cars from the website on schedule)
  //   */30 * * * *  -> orphan-uploads (delete uploads never attached to a record)
  //   0 6 * * *     -> cazoo-health   (daily Cazoo import canary)
  "triggers": {
    "crons": ["*/15 * * * *", "*/30 * * * *", "0 6 * * *"]
  },
  // Non-secret configuration. Secrets (SUPABASE_SERVICE_ROLE_KEY,
  // SENDGRID_API_KEY, CRON_SECRET, RAPID_CAR_CHECK_API_KEY, FIRECRAWL_API_KEY) are set
  // with `wrangler secret put` or in the Cloudflare dashboard.
  "vars": {
    "APP_URL": "https://cardealerstockbook.racecargraphics.uk",
    "SUPABASE_URL": "https://bvtqaehyqchyoaleiggw.supabase.co",
    // Email goes out via the SendGrid API (secret: SENDGRID_API_KEY). The
    // from-address must be a verified sender / authenticated domain in SendGrid.
    // Testing sender; change to the dealer domain (and authenticate it in SendGrid) for go-live.
    "ENQUIRY_EMAIL_FROM": "noreply@racecargraphics.uk",
    "EMAIL_FROM_NAME": "MotorMetric",
    "RAPID_CAR_CHECK_DOMAIN": "motormetric-mg.co.uk"
  }
}
