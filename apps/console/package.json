{
  "name": "@workspace/console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate": "drizzle-kit generate --dialect postgresql --schema ./src/db/schema.ts --out ./migrations",
    "migrate": "node scripts/migrate.mjs",
    "cloudflare:build": "opennextjs-cloudflare build",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:dev": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env dev"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0",
    "@workspace/modules": "workspace:*",
    "drizzle-orm": "catalog:",
    "next": "15.5.27",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.9",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "drizzle-kit": "^0.31.10",
    "pg": "^8.20.0",
    "postcss": "^8.5.28",
    "tailwindcss": "catalog:",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "4.129.1"
  }
}
